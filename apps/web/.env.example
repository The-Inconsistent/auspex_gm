# Clerk (Dashboard → API keys). Copy to .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dev only: the LAN hosts the dev server accepts, so phones and tablets at the table can open the app at this
# machine's address (comma separated, no scheme or port). Without it they render but never hydrate.
DEV_ORIGINS=

# Dev only: this machine's LAN address, put into QR codes and invite links when the GM is working at localhost — a
# phone resolves localhost to itself, so such a code is unscannable. One host, no scheme and no port (the browser's
# own port is kept). Unset in production, where the GM is already on the real hostname. A value with a scheme, a port
# or a path stops the dev server and the build (next.config.ts), because a bad one is invisible until a phone won't
# open the code.
NEXT_PUBLIC_DEV_HOST=
