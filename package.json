{
  "name": "wrath-glory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:db": "docker compose up -d --wait postgres",
    "dev:api": "bun --filter @wg/api dev",
    "dev:web": "bun --filter @wg/web dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "bun test packages apps/web",
    "test:smoke": "bun --filter @wg/api test:smoke",
    "validate": "bun packages/data/validate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
